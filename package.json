{
  "name": "my-saas-boilerplate",
  "private": true,
  "version": "1.0.0",
  "description": "Convex backend template for monetised Telegram SaaS bots: one service per repo, Stars payments, async job queue.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "convex dev",
    "dev:poll": "tsx scripts/dev-poll.ts",
    "deploy": "convex deploy",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json"
  },
  "dependencies": {
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
