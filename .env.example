# Local secrets for dev tooling (scripts/) and `npx convex dev`.
# NEVER commit this file. In production these live as Convex env vars
# (`npx convex env set NAME value`), not in the repo.
#
# Required:
BOT_TOKEN=
WEBHOOK_SECRET=dev
# The provider submission payload (JSON). No sample workflows live in the
# repo — supply your own per deployment:
#   fal:     PROVIDER_PAYLOAD='{"model":"fal-ai/…","input":{…}}'
#   comfyui: PROVIDER_PAYLOAD='{"workflow":{…API-format graph…}}'
PROVIDER_PAYLOAD=
# Providers (only the ones your service uses):
FAL_KEY=
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
# Prod webhook target for `npm run webhook:set`:
WEBHOOK_URL=
# Dev long-polling target (defaults to http://127.0.0.1:3210):
DEV_HTTP_URL=
