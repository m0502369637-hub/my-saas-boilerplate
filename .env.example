# ============================================================================
#  IMPORTANT — the platform never reads this file.
#
#  Telegram Serverless has no environment access: no process.env, no .env, no
#  `tgcloud secrets`. Only `schema.js`, `lib/**`, and `handlers/*.js` are
#  deployed. Bot-side credentials therefore live in lib/secrets.js (see it).
#  The variables below are consumed ONLY by the optional completion relay
#  (relay/relay.mjs), a tiny Node app you host yourself.
# ============================================================================

# --- relay/relay.mjs --------------------------------------------------------

# Bot API token (from @BotFather). The platform itself never needs this —
# only the relay does, to nudge users from your own infrastructure.
BOT_TOKEN=

# HTTP port the relay listens on (default 8787).
PORT=8787

# How often the relay polls tracked ComfyUI/Fal jobs (default 15000 ms).
RELAY_POLL_MS=15000

# Stop tracking a job after this long (default 1200000 ms = 20 min).
# The bot's own timeout + refund policy still applies regardless.
RELAY_MAX_TRACK_MS=1200000

# --- reference map → lib/secrets.js -----------------------------------------
# These names are listed for orientation only; copy the values into
# lib/secrets.js before deploying the bot:
#
#   FAL_KEY=...                       → secrets.falKey            (https://fal.ai/dashboard/keys)
#   COMFYUI_BASE_URL=https://...      → secrets.comfyuiBaseUrl    (self-hosted --listen, RunComfy, …)
#   COMFYUI_API_KEY=...               → secrets.comfyuiApiKey     (optional bearer for hosted ComfyUI)
#   RELAY_BASE_URL=https://relay...   → secrets.relayBaseUrl      (optional — enables the relay path)
#   DEFAULT_PROVIDER=fal_ai           → secrets.provider          ('fal_ai' | 'comfyui')
#
#   TGCLOUD_TOKEN=app123456:secret    → CLI auth for CI only (never written to disk)
